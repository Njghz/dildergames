# ============================================================
# База данных PostgreSQL
# Пример: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# ============================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus?schema=public"

# ============================================================
# Секрет для подписи сессионных cookie администратора.
# Генерация: openssl rand -base64 32
# Никогда не коммитьте настоящее значение в git.
# ============================================================
SESSION_SECRET="change-me-openssl-rand-base64-32"

# ============================================================
# Данные первого администратора (используются скриптом
# prisma/seed.ts при первом запуске). После создания
# администратора эти значения можно удалить из .env.
# ============================================================
SEED_ADMIN_EMAIL="admin@nexus.gg"
SEED_ADMIN_PASSWORD="change-me-strong-password"

# Базовый URL сайта (используется для ссылок в письмах/уведомлениях)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Включить демо-данные при seed (true/false)
SEED_DEMO_DATA="true"
